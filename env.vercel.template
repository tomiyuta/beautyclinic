# ============================================
# Vercel環境変数設定用テンプレート
# ============================================
# このファイルの内容をコピーして、Vercelダッシュボードの
# 「Import .env」機能で使用するか、手動で環境変数を設定してください
# ============================================

# ============================================
# データベース設定（必須）
# ============================================
# MySQLデータベースの接続文字列
# 形式: mysql://ユーザー名:パスワード@ホスト:ポート/データベース名
# 例: mysql://user:password@host.example.com:3306/beautyclinic
DATABASE_URL=mysql://user:password@host:3306/beautyclinic

# Prisma設定
PRISMA_GENERATE_DATAPROXY=false

# ============================================
# AI API Keys（使用するサービスのみ設定）
# ============================================

# Google Gemini API
# 取得方法: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Grok API (X/Twitter)
# 取得方法: https://x.ai/
GROK_API_KEY=your-grok-api-key-here

# Anthropic Claude API
# 取得方法: https://console.anthropic.com/
CLAUDE_API_KEY=your-claude-api-key-here

# OpenAI ChatGPT API
# 取得方法: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# ============================================
# AI Model設定（オプション）
# ============================================

# Claude Model（デフォルト: 自動選択）
# 利用可能なモデル: claude-3-5-sonnet, claude-3-opus, claude-3-sonnet, claude-3-haiku
CLAUDE_MODEL=claude-3-5-sonnet

# Gemini Model（デフォルト: 自動選択）
# 利用可能なモデル: gemini-pro, gemini-pro-vision
GEMINI_MODEL=gemini-pro

# Grok Model（デフォルト: grok-3）
# 利用可能なモデル: grok-3, grok-beta
GROK_MODEL=grok-3

# Grok API URL（デフォルト: https://api.x.ai/v1/chat/completions）
GROK_API_URL=https://api.x.ai/v1/chat/completions

# 戦略分析で使用するAIプロバイダー（デフォルト: chatgpt）
# 選択肢: claude, chatgpt
STRATEGY_AI_PROVIDER=chatgpt

# ============================================
# Web検索API設定（いずれか1つを設定）
# ============================================

# オプション1: SerpAPI（推奨）
# 取得方法: https://serpapi.com/
SERP_API_KEY=your-serp-api-key-here

# オプション2: Google Custom Search API
# 取得方法: https://developers.google.com/custom-search/v1/overview
GOOGLE_CUSTOM_SEARCH_API_KEY=your-google-custom-search-api-key-here
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=your-google-custom-search-engine-id-here

# ============================================
# 注意事項
# ============================================
# 1. 実際のAPIキーとデータベース接続情報に置き換えてください
# 2. このファイルは機密情報を含むため、Gitにコミットしないでください
# 3. Vercelでは環境変数が自動的に暗号化されます
# 4. 環境ごと（Production/Preview/Development）に異なる値を設定できます
# 5. 使用しないAPIキーは削除しても問題ありません

