generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "darwin-arm64", "darwin", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ResearchType {
  trend_analysis
  competitor_analysis
  price_research
}

enum AiAgent {
  gemini
  grok
  claude
  chatgpt
  pika
  synthesia
}

enum SNSPlatform {
  twitter
  instagram
  youtube
  tiktok
}

enum ImplementationStatus {
  pending
  in_progress
  completed
}

enum ContentType {
  instagram_lp
  website_article
  campaign_copy
  // 新規追加（フェーズ1）
  instagram_post_text
  instagram_post_image
  instagram_story
  ad_banner
  lp_visual
  // フェーズ2以降
  instagram_reels
  tiktok_video
  youtube_shorts
  treatment_explanation_video
  pre_care_video
  post_care_video
  faq_video
}

enum ContentStatus {
  draft
  approved
  published
}

enum WorkflowStatus {
  running
  completed
  failed
}

enum PromptType {
  // Claude
  claude_analyze_market_position
  claude_generate_price_recommendations
  claude_generate_campaign_proposals
  claude_suggest_new_treatments
  claude_research_trend_analysis
  claude_research_price_comparison
  claude_research_competitor_analysis
  // Gemini
  gemini_research_trend_analysis
  gemini_research_price_comparison
  gemini_analyze_instagram_trends
  gemini_analyze_youtube_trends
  gemini_analyze_tiktok_trends
  gemini_research_competitor_analysis
  // Grok
  grok_analyze_twitter_trends
  grok_research_trend_analysis
  grok_research_price_comparison
  grok_research_competitor_analysis
  // ChatGPT
  chatgpt_system_prompt
  chatgpt_generate_instagram_lp
  chatgpt_generate_website_article
  chatgpt_generate_campaign_copy
  chatgpt_research_trend_analysis
  chatgpt_research_price_comparison
  chatgpt_research_competitor_analysis
}

model ClinicProduct {
  id           Int      @id @default(autoincrement())
  userId       Int
  name         String   @db.VarChar(255)
  category     String?  @db.VarChar(100)
  costPrice    Int
  sellingPrice Int
  description  String?  @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("clinicProducts")
}

model MarketResearchResult {
  id            Int          @id @default(autoincrement())
  userId        Int
  location      String       @db.VarChar(500)
  researchType  ResearchType
  aiAgent       AiAgent
  rawData       String       @db.Text
  processedData String?      @db.Text
  createdAt     DateTime     @default(now())

  @@map("marketResearchResults")
}

model SNSResearchResult {
  id        Int         @id @default(autoincrement())
  userId    Int
  platform  SNSPlatform
  keywords  String      @db.Text
  aiAgent   AiAgent
  trendData String      @db.Text
  createdAt DateTime    @default(now())

  @@map("snsResearchResults")
}

model StrategyRecommendation {
  id                      Int                  @id @default(autoincrement())
  userId                  Int
  analysisDate            DateTime             @default(now())
  priceRecommendations    String?              @db.Text
  campaignProposals       String?              @db.Text
  newTreatmentSuggestions String?              @db.Text
  marketingStrategy       String?              @db.Text
  userFeedback            String?              @db.Text
  implementationStatus    ImplementationStatus @default(pending)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@map("strategyRecommendations")
}

model GeneratedContent {
  id               Int           @id @default(autoincrement())
  userId           Int
  strategyId       Int
  contentType      ContentType
  title            String        @db.VarChar(255)
  content          String        @db.LongText
  metadata         String?       @db.Text
  aiAgent          AiAgent
  status           ContentStatus @default(draft)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  complianceReport String?       @db.Text
  complianceStatus String?       @db.VarChar(20)
  fileSize         Int?
  fileUrl          String?       @db.LongText
  mimeType         String?       @db.VarChar(100)
  templateId       Int?
  variations       String?       @db.Text

  @@map("generatedContents")
}

model WorkflowExecution {
  id           Int            @id @default(autoincrement())
  userId       Int
  workflowType String         @db.VarChar(100)
  status       WorkflowStatus
  steps        String         @db.Text
  results      String?        @db.Text
  errorMessage String?        @db.Text
  startedAt    DateTime       @default(now())
  completedAt  DateTime?

  @@map("workflowExecutions")
}

model ErrorLog {
  id           Int       @id @default(autoincrement())
  userId       Int
  module       String    @db.VarChar(100)
  errorType    String    @db.VarChar(100)
  errorMessage String    @db.Text
  stackTrace   String?   @db.Text
  context      String?   @db.Text
  aiAgent      AiAgent?
  isNotified   Boolean   @default(false)
  notifiedAt   DateTime?
  resolved     Boolean   @default(false)
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@map("errorLogs")
}

model PromptTemplate {
  id          Int                        @id @default(autoincrement())
  promptType  promptTemplates_promptType @unique
  aiAgent     AiAgent
  name        String                     @db.VarChar(255)
  description String?                    @db.Text
  prompt      String                     @db.Text
  isActive    Boolean                    @default(true)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@map("promptTemplates")
}

model UserSettings {
  id                     Int      @id @default(autoincrement())
  userId                 Int      @unique
  strategyAIProvider     String   @default("chatgpt") @db.VarChar(20) // "claude", "chatgpt", "gemini", "grok"
  marketResearchAIProvider String @default("gemini") @db.VarChar(20) // "claude", "chatgpt", "gemini", "grok"
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("userSettings")
}

model ContentTemplate {
  id          Int         @id @default(autoincrement())
  userId      Int
  name        String      @db.VarChar(255)
  contentType ContentType
  settings    String      @db.Text
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("contentTemplates")
}

model ComplianceCheckLog {
  id         Int      @id @default(autoincrement())
  contentId  Int
  checkType  String   @db.VarChar(20)
  violations String?  @db.Text
  warnings   String?  @db.Text
  status     String   @db.VarChar(20)
  checkedAt  DateTime @default(now())

  @@map("complianceCheckLogs")
}

model AiSpace {
  id          String      @id @default(uuid())
  userId      Int
  name        String      @db.VarChar(255)
  description String?     @db.Text
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  sessions    AiSession[]
  skills      AiSkill[]

  @@index([userId])
  @@map("ai_spaces")
}

model AiSession {
  id               String             @id @default(uuid())
  spaceId          String?            @map("space_id")
  title            String?
  status           AiSessionStatus    @default(active)
  context          Json?
  experienceStatus AiExperienceStatus @default(pending) @map("experience_status")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  completedAt      DateTime?          @map("completed_at")
  experienceJobs   AiExperienceJob[]
  messages         AiMessage[]
  space            AiSpace?           @relation(fields: [spaceId], references: [id])
  tasks            AiTask[]

  @@index([spaceId])
  @@index([status])
  @@index([experienceStatus])
  @@index([createdAt])
  @@map("ai_sessions")
}

model AiMessage {
  id        String    @id @default(uuid())
  sessionId String    @map("session_id")
  role      String    @db.VarChar(20)
  content   String    @db.LongText
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at")
  session   AiSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("ai_messages")
}

model AiTask {
  id              String       @id @default(uuid())
  sessionId       String       @map("session_id")
  order           Int
  description     String       @db.Text
  status          AiTaskStatus @default(pending)
  progresses      Json?
  userPreferences Json?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  completedAt     DateTime?    @map("completed_at")
  session         AiSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([status])
  @@index([createdAt])
  @@map("ai_tasks")
}

model AiSkill {
  id          String            @id @default(uuid())
  spaceId     String?           @map("space_id")
  name        String            @db.VarChar(255)
  description String            @db.Text
  steps       Json
  complexity  AiSkillComplexity @default(simple)
  tags        Json?
  usageCount  Int               @default(0) @map("usage_count")
  successRate Float?            @default(0) @map("success_rate")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  space       AiSpace?          @relation(fields: [spaceId], references: [id])

  @@index([spaceId])
  @@index([name])
  @@fulltext([name, description])
  @@map("ai_skills")
}

model AiExperienceJob {
  id          String             @id @default(uuid())
  sessionId   String             @map("session_id")
  jobType     String             @db.VarChar(50)
  status      AiExperienceStatus @default(pending)
  input       Json?
  output      Json?
  error       String?            @db.Text
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  completedAt DateTime?          @map("completed_at")
  session     AiSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([status])
  @@index([jobType])
  @@index([createdAt])
  @@map("ai_experience_jobs")
}

model AiArtifact {
  id          String        @id @default(uuid())
  sessionId   String?       @map("session_id")
  name        String        @db.VarChar(255)
  storageType AiStorageType @map("storage_type")
  path        String        @db.VarChar(500)
  size        Int
  mimeType    String?       @map("mime_type") @db.VarChar(100)
  metadata    Json?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([sessionId])
  @@index([storageType])
  @@index([createdAt])
  @@map("ai_artifacts")
}

model AiMetric {
  id         Int      @id @default(autoincrement())
  spaceId    String?  @map("space_id")
  metricType String   @map("metric_type") @db.VarChar(50)
  date       DateTime @db.Date
  data       Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([spaceId, metricType, date])
  @@index([spaceId])
  @@index([metricType])
  @@index([date])
  @@map("ai_metrics")
}

enum ResearchType {
  trend_analysis
  competitor_analysis
  price_research
}

enum AiAgent {
  gemini
  grok
  claude
  chatgpt
  pika
  synthesia
}

enum SNSPlatform {
  twitter
  instagram
  youtube
  tiktok
}

enum ImplementationStatus {
  pending
  in_progress
  completed
}

enum ContentType {
  instagram_lp
  website_article
  campaign_copy
  instagram_post_text
  instagram_post_image
  instagram_story
  ad_banner
  lp_visual
  instagram_reels
  tiktok_video
  youtube_shorts
  treatment_explanation_video
  pre_care_video
  post_care_video
  faq_video
}

enum ContentStatus {
  draft
  approved
  published
}

enum WorkflowStatus {
  running
  completed
  failed
}

enum AiSessionStatus {
  active
  completed
  archived
}

enum AiExperienceStatus {
  pending
  processing
  completed
  failed
}

enum AiTaskStatus {
  pending
  running
  success
  failed
}

enum AiStorageType {
  database
  s3
  local
}

enum AiSkillComplexity {
  simple
  medium
  complex
}

enum promptTemplates_promptType {
  claude_analyze_market_position
  claude_generate_price_recommendations
  claude_generate_campaign_proposals
  claude_suggest_new_treatments
  gemini_research_trend_analysis
  gemini_research_price_comparison
  gemini_analyze_instagram_trends
  gemini_analyze_youtube_trends
  gemini_analyze_tiktok_trends
  gemini_research_competitor_analysis
  grok_analyze_twitter_trends
  chatgpt_system_prompt
  chatgpt_generate_instagram_lp
  chatgpt_generate_website_article
  chatgpt_generate_campaign_copy
